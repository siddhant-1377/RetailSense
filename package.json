{
  "name": "retailsense-dwm-mini-project",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/install-python.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite --config frontend/vite.config.ts",
